# ========== 智谱（识别药盒图片用的 AI）==========
# 申请地址：https://open.bigmodel.cn
# 步骤：注册/登录 → 右上角「控制台」→ 左侧「API Keys」→ 新建密钥
# glm-4v-flash 模型目前免费，足够本项目使用
ZHIPU_API_KEY=c2f14ea19cca45f69c44efb98f3eb0a0.fNxHvjjWcHlh0j00

# ========== MiniMax（语音播报用的 TTS）==========
# 申请地址：https://platform.minimaxi.com
# 步骤：注册/登录 → 右上角头像 → 「账户管理」→ 复制 API Key 和 Group ID
MINIMAX_API_KEY=sk-api-M0Zpm5zmuoBLsPlL5FD2KhfJnkEvqgDdwbL_BONOLXsTudFQQK30UcjX9X9lipGmNLZpHisA4kPbVkOkHeCgmGrfXpsKfX-Giv9y8d1eIdIRRyDkW_e70Ms
# 部分账号调用语音接口必须带 Group ID，如果语音报错提示 GroupId，把这个填上
MINIMAX_GROUP_ID=2105275761706406072

# ========== 可选：额外信任的域名 ==========
# 默认只放行"和本站同源"的请求（电脑 localhost、手机局域网 IP、Vercel 域名都自动放行）。
# 如果你把前端和接口部署到不同域名，把前端域名填这里，多个用英文逗号分隔：
# ALLOWED_ORIGINS=https://你的前端域名

# ========== 可选：换朗读声音 / 方言 / 语速 ==========
# 默认是男声 male-qn-jingying（清晰稳重，适合播报）
# 想换声音的话，去 MiniMax 文档看可选 voice_id，填到这里并去掉行首的 #
# TTS_VOICE_ID=

# 方言／语种增强：默认 Chinese（普通话）
# 中文方言**官方只支持粤语** → 填 Chinese,Yue；不确定语种可填 auto
# （四川话、东北话、湖北话等暂不支持，这类建议换成更亲切的普通话 voice_id + 放慢语速）
# TTS_LANGUAGE_BOOST=Chinese

# 语速：0.5（很慢）~ 2.0（很快），默认 0.9
# 家里老人听不清，可以调到 0.7 ~ 0.8 更慢一点
# TTS_SPEED=0.9

# 音量倍率：0.1（很轻）~ 5.0（最大），默认 4.0
# TTS_VOL=4.0

# ========== 可选：外部药品数据库验证 ==========
# 这些 Key 只在后端服务端使用，不会出现在前端代码中，也不会被 Git 上传。
# 目前已接入：openFDA、RxNorm、DailyMed、UniTCM（全部免费公开数据库）
# openFDA API Key（可选）：不填也能用，但有每分钟 240 次调用限制；
# 申请地址：https://open.fda.gov/apis/authentication/
# OPENFDA_API_KEY=

# 启用哪些验证来源，用英文逗号分隔；不填则启用全部
# 可选值：openFDA,RxNorm,DailyMed,UniTCM
# ENABLE_DRUG_VERIFICATION_SOURCES=openFDA,RxNorm,DailyMed,UniTCM

# ========== 易源数据（国内药品说明书数据库）==========
# 用于三层验证链路：批准文号核验 → 说明书字段核验 → 代码打分裁决
# 申请地址：https://www.showapi.com
# 步骤：注册/登录 → 搜索「药品」→ 找到「药品说明书」接口 → 购买/免费试用后复制 AppKey
# 本 Key 只在后端服务端使用，不会出现在前端代码中
YIYUAN_APP_KEY=6ad2607Ea57849019978DDA9bB581c9f
